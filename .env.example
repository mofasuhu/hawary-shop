# Copy to .env and fill with your own sandbox/dev values.
# Never commit real secrets. Production stays in private MyApp / Render.

FLASK_ENV=development
FLASK_DEBUG=1
DEBUG=1
HOST=127.0.0.1
PORT=5000
SECRET_KEY=change-me-to-a-long-random-string
RENDER=

# Database (use a local Postgres URL for development)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hawary_shop
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hawary_shop
DB_USER=USER
DB_PASSWORD=PASSWORD

# First superadmin seed (local only)
FIRST_SUPERADMIN_FULLNAME=Admin
FIRST_SUPERADMIN_MAIL=admin@example.com
FIRST_SUPERADMIN_PASSWORD=change-me
FIRST_SUPERADMIN_MOBILE=
FIRST_SUPERADMIN_ADDRESS=
FIRST_SUPERADMIN_AREA=

# Email
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@example.com

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (media)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Paymob (use sandbox keys for local/dev — never production keys in this public repo)
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_CALLBACK_WEBHOOK=https://example.com/webhooks/paymob

OUTPUT_FILE=
